{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "siq-small-editor": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": ".build/angular",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": ["src/styles.scss"],
            "assets": [
              { "glob": "**/*", "input": "src/assets", "output": "src/assets" }
            ],
            "baseHref": "./",
            "outputHashing": "none",
            "extractLicenses": true
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "budgets": [
                { "type": "initial", "maximumWarning": "3mb", "maximumError": "4mb" },
                { "type": "anyComponentStyle", "maximumWarning": "10kb", "maximumError": "16kb" }
              ]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "siq-small-editor:build:production" },
            "development": { "buildTarget": "siq-small-editor:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
